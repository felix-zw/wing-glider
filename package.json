{
  "name": "wing-glider",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test src/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "art:models": "node tools/art/build-models.mjs",
    "art:validate": "node tools/art/validate_assets.mjs",
    "art:surfaces": "python tools/generate-surfaces.py && node tools/encode-surfaces.mjs"
  },
  "dependencies": { "three": "^0.180.0" },
  "devDependencies": { "@types/three": "^0.180.0", "@types/node": "^24.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.1.0" }
}
